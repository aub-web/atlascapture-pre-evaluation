# Copy to .env and fill in. `npm start` loads it automatically.

# Emails on these domains sign in without approval (comma-separated).
# Any other email needs an admin/manager to approve it first.
ALLOWED_DOMAINS=atlascapture.io

# Email (SMTP). Used for sign-in codes AND ticket notifications ("new photo needs review", "approved",
# "returned"). Until this is set, sign-in codes are shown on screen (test mode) and no emails go out.
# Google Workspace example: smtp.gmail.com, port 587, a sender account + an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@atlascapture.io
# SMTP_PASS=
# MAIL_FROM=Studio Setup QC <noreply@atlascapture.io>

# Public URL of the app, used for links in emails. Use https in production (also marks cookies Secure).
# APP_URL=https://setup-qc.atlascapture.io

# Optional: OAuth 2.0 Web client ID to also offer "Sign in with Google" (see README).
GOOGLE_CLIENT_ID=

# Set to 1 to enable the no-password name picker (local development only).
# DEV_LOGIN=1

# PORT=3000
# SESSION_SECRET=

# Shared password in front of the whole site (test deployments).
# SITE_PASSWORD=

# Postgres connection. Leave unset locally to use the embedded database in data/pg.
# On Netlify, Netlify DB sets NETLIFY_DATABASE_URL automatically.
# DATABASE_URL=postgres://user:pass@host/db

# Emails that are always active admins (needed to sign in to a fresh online database).
# BOOTSTRAP_ADMINS=you@atlascapture.io
