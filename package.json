{
  "name": "spl-ticketing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-recording setup approval tool for the Studio QA/Capture team",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test-email": "node --env-file-if-exists=.env scripts/test-email.js",
    "setup-email": "node scripts/setup-email.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "google-auth-library": "^9.15.1",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1"
  }
}
