{
  "name": "spl-ticketing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-recording setup approval tool for the Studio QA/Capture team",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test-email": "node --env-file-if-exists=.env scripts/test-email.js",
    "setup-email": "node scripts/setup-email.js",
    "export-roster": "node scripts/export-roster.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@netlify/blobs": "^8.2.0",
    "express": "^5.3.0",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.0.22"
  }
}
